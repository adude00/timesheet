# Copy to .env and fill in. Never commit the real SECRET_KEY.

# IANA timezone your hours belong to (required).
APP_TIMEZONE=Europe/Rome

# Required. Generate one for this install:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
SECRET_KEY=change-me-with-a-random-32-byte-token

# Where the SQLite database lives inside the container (default shown).
DATABASE_PATH=/data/timesheet.sqlite3

# Port Gunicorn listens on.
BIND=0.0.0.0:8080

# Set to 1 ONLY when a documented reverse proxy forwards X-Forwarded-Proto.
# See README "Reverse proxy". Leave at 0 otherwise.
TRUST_PROXY=0

# Session cookie is sent only over HTTPS. Set to 0 for local HTTP testing.
COOKIE_SECURE=1
